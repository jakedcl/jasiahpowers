# Sanity (optional overrides; defaults match the deployed project)
# NEXT_PUBLIC_SANITY_PROJECT_ID=k4dm6cys
# NEXT_PUBLIC_SANITY_DATASET=production

# Server-only token with write access, used by /api/booking.
# Create it in sanity.io/manage → API → Tokens. Editor is enough.
# Without it, the contact form falls back to email.
SANITY_API_WRITE_TOKEN=

# YouTube Data API — server-only; required for /video playlist
# Create a key in Google Cloud Console with YouTube Data API v3 enabled
YOUTUBE_API_KEY=
# Optional override (default matches the previous site)
# YOUTUBE_PLAYLIST_ID=PLNo5tM02yzAVMsvykDJfejRnaZ6Ut0eSQ
