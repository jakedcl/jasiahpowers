# Sanity (optional overrides; defaults match the deployed project)
# NEXT_PUBLIC_SANITY_PROJECT_ID=k4dm6cys
# NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. Create a key at resend.com/api-keys.
# Without it, the booking form falls back to email.
RESEND_API_KEY=
# Optional. Defaults to jasiahsteez@gmail.com.
# BOOKING_TO_EMAIL=jasiahsteez@gmail.com
# Optional. Defaults to onboarding@resend.dev, which works before a domain is verified.
# After a domain is verified, set this to that sender, for example:
# BOOKING_FROM_EMAIL=Jasiah Powers <bookings@jasiahpowers.com>


# YouTube Data API — server-only; required for /video playlist
# Create a key in Google Cloud Console with YouTube Data API v3 enabled
YOUTUBE_API_KEY=
# Optional override (default matches the previous site)
# YOUTUBE_PLAYLIST_ID=PLNo5tM02yzAVMsvykDJfejRnaZ6Ut0eSQ
